# 自动生成：python3 scripts/gen-redirects.py（勿手改 /go/ 部分）
fwqabc.com {
	root * /var/www/fwqabc
	encode zstd gzip
	redir /go/bandwagonhost https://bandwagonhost.com/cart.php?a=add&pid=88 302
	redir /go/bandwagonhost/ https://bandwagonhost.com/cart.php?a=add&pid=88 302
	redir /go/namesilo https://www.namesilo.com/ 302
	redir /go/namesilo/ https://www.namesilo.com/ 302
	redir /go/racknerd https://www.racknerd.com/specials/ 302
	redir /go/racknerd/ https://www.racknerd.com/specials/ 302
	redir /go/raksmart https://www.raksmart.com/activity/index/page/activitypage_25.html 302
	redir /go/raksmart/ https://www.raksmart.com/activity/index/page/activitypage_25.html 302
	redir /go/vultr https://www.vultr.com/ 302
	redir /go/vultr/ https://www.vultr.com/ 302
	header /go/* X-Robots-Tag "noindex, nofollow"
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	file_server
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.fwqabc.com {
	redir https://fwqabc.com{uri} 301
}
